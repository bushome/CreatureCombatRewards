<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="src\Main.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="src\RewardLogic.h" />
    <ClInclude Include="src\ShopBridge.h" />
  </ItemGroup>
  <ItemGroup>
    <None Include="configs\config.json" />
    <None Include="configs\PluginInfo.json" />
    <None Include="README.md" />
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <Keyword>Win32Proj</Keyword>
    <ProjectGuid>{AA2A983D-3DCD-4745-88C4-D105A825446A}</ProjectGuid>
    <RootNamespace>CreatureCombatRewards</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <ProjectName>CreatureCombatRewards</ProjectName>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings">
  </ImportGroup>
  <ImportGroup Label="Shared">
  </ImportGroup>
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros">
    <!-- Where the AsaApi source tree and AsaApi.lib live. Override either one on the msbuild command
         line (/p:AsaApiDir=...) or as an environment variable if yours are somewhere else. -->
    <AsaApiDir Condition="'$(AsaApiDir)' == ''">$(MSBuildProjectDirectory)\extern\AsaApi\</AsaApiDir>
    <AsaApiLib Condition="'$(AsaApiLib)' == ''">$(AsaApiDir)out_lib\AsaApi.lib</AsaApiLib>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <!-- out\CreatureCombatRewards\ ends up holding exactly what goes into ArkApi\Plugins\CreatureCombatRewards\ -->
    <OutDir>$(MSBuildProjectDirectory)\out\$(ProjectName)\</OutDir>
    <IntDir>$(MSBuildProjectDirectory)\out\obj\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>PROJECT_NAME="$(ProjectName)";NDEBUG;_WINDOWS;_USRDLL;_CRT_SECURE_NO_WARNINGS;_SILENCE_ALL_CXX17_DEPRECATION_WARNINGS;_SILENCE_ALL_CXX20_DEPRECATION_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalIncludeDirectories>$(AsaApiDir)AsaApi\Core\Public\;$(AsaApiDir)AsaApi\Core\Public\API\UE\;$(MSBuildProjectDirectory)\src\;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <EnableUAC>false</EnableUAC>
      <ImportLibrary>$(IntDir)$(TargetName).lib</ImportLibrary>
      <AdditionalDependencies>$(AsaApiLib);$(CoreLibraryDependencies);%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <PreBuildEvent>
      <Command>if exist "$(TargetDir)$(TargetFileName).arkapi" del /q "$(TargetDir)$(TargetFileName).arkapi"</Command>
    </PreBuildEvent>
    <PostBuildEvent>
      <Command>copy /y "$(TargetDir)$(TargetFileName)" "$(TargetDir)$(TargetFileName).arkapi"
copy /y "$(MSBuildProjectDirectory)\configs\PluginInfo.json" "$(TargetDir)PluginInfo.json"
copy /y "$(MSBuildProjectDirectory)\configs\config.json" "$(TargetDir)config.json"</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
  <!-- Fail early with a readable message if AsaApi has not been set up yet. -->
  <Target Name="CheckAsaApi" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(AsaApiDir)AsaApi\Core\Public\API\ARK\Ark.h')" Text="AsaApi headers not found under $(AsaApiDir). Run setup.bat, or clone https://github.com/ArkServerApi/AsaApi into extern\AsaApi." />
    <Error Condition="!Exists('$(AsaApiLib)')" Text="AsaApi.lib not found at $(AsaApiLib). Copy it from the Lib folder of the AsaApi release zip into extern\AsaApi\out_lib, or build extern\AsaApi\AsaApi.sln (Release, x64)." />
  </Target>
</Project>
